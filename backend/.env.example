# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# Fixed token the app must send in the X-API-Key header.
# Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
HYPER_READER_API_KEY=change-me

# Your OpenAI API key.
OPENAI_API_KEY=

# AI model used by the agents (optional).
# HYPER_READER_MODEL=gpt-5-mini
