meta {
  name: Spanish book, English reader (real AI)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/translate
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "bookLanguage": "es",
    "targetLanguage": "en-US",
    "word": "banco",
    "sentence": "Se sentó en el banco del parque a leer."
  }
}

assert {
  res.status: eq 200
  res.body.translation: isString
}

docs {
  The target language is a request parameter: here the translation and note
  should come back in English.
}
